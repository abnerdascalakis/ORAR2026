<% content_for :title, "Leitor QR | Admin" %>

<% actions = capture do %>
  <%= link_to admin_root_path, class: "btn btn-outline-light" do %>
    <i class="bi bi-arrow-left-circle me-2"></i>Voltar
  <% end %>

  <%= link_to admin_refeicoes_path, class: "btn btn-light shadow-sm" do %>
    <i class="bi bi-cup-hot me-2"></i>Refeicoes
  <% end %>

  <button
    type="button"
    class="btn btn-light shadow-sm"
    data-bs-toggle="modal"
    data-bs-target="#qrCredentialModal"
  >
    <i class="bi bi-printer me-2"></i>Gerar QR Code
  </button>
<% end %>

<div data-controller="qr-credential-picker">
    <div class="modal fade admin-qr-modal" id="qrCredentialModal" tabindex="-1" aria-labelledby="qrCredentialModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
          <%= form_with url: credenciais_admin_inscricoes_path, method: :get, data: { turbo: false }, html: { class: "m-0" } do %>
            <div class="modal-header px-4 py-3">
              <h2 class="modal-title h5 fw-bold" id="qrCredentialModalLabel">Gerar QR Code</h2>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <div class="modal-body px-4">
              <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                  <button
                    type="button"
                    class="nav-link active"
                    id="qr-districts-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#qr-districts-pane"
                    role="tab"
                    aria-controls="qr-districts-pane"
                    aria-selected="true"
                  >
                    Selecionar Distritos
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button
                    type="button"
                    class="nav-link"
                    id="qr-person-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#qr-person-pane"
                    role="tab"
                    aria-controls="qr-person-pane"
                    aria-selected="false"
                  >
                    Pesquisar Pessoa
                  </button>
                </li>
              </ul>

              <div class="tab-content">
                <div class="tab-pane fade show active" id="qr-districts-pane" role="tabpanel" aria-labelledby="qr-districts-tab" tabindex="0">
                  <div class="form-check mb-3">
                    <input
                      type="checkbox"
                      class="form-check-input"
                      id="qr_credential_select_all_districts"
                      data-action="change->qr-credential-picker#toggleAllDistricts"
                      data-qr-credential-picker-target="selectAll"
                    >
                    <label class="form-check-label fw-semibold" for="qr_credential_select_all_districts">Selecionar todos</label>
                  </div>

                  <div class="input-group mb-2">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input
                      type="search"
                      id="qr_credential_district_search"
                      class="form-control"
                      placeholder="Pesquisar distrito..."
                      autocomplete="off"
                      data-qr-credential-picker-target="districtSearch"
                      data-action="input->qr-credential-picker#filterDistricts"
                    >
                  </div>

                  <div class="admin-qr-picker__actions d-flex align-items-center justify-content-between gap-3 flex-wrap my-3">
                    <span class="small text-secondary" data-qr-credential-picker-target="count">0 distritos selecionados</span>
                    <button type="submit" class="btn btn-primary" data-qr-credential-picker-target="districtSubmit" disabled>
                      <i class="bi bi-printer me-1"></i>Gerar por distrito
                    </button>
                  </div>

                  <div class="admin-qr-picker__districts list-group">
                    <% @distritos.each do |distrito| %>
                      <label
                        class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                        data-qr-credential-picker-target="option"
                        data-district-name="<%= distrito.nome %>"
                      >
                        <%= check_box_tag "q[distrito_id_in][]",
                          distrito.id,
                          false,
                          class: "form-check-input m-0",
                          data: {
                            qr_credential_picker_target: "checkbox",
                            action: "change->qr-credential-picker#update"
                          } %>
                        <span><%= distrito.nome %></span>
                      </label>
                    <% end %>

                    <div class="list-group-item text-secondary d-none" data-qr-credential-picker-target="empty">
                      Nenhum distrito encontrado.
                    </div>
                  </div>
                </div>

                <div class="tab-pane fade" id="qr-person-pane" role="tabpanel" aria-labelledby="qr-person-tab" tabindex="0">
                  <label class="form-label fw-semibold" for="qr_credential_person_name">Nome da pessoa</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input
                      type="search"
                      id="qr_credential_person_name"
                      name="q[pessoa_nome_cont]"
                      class="form-control"
                      placeholder="Pesquisar pessoa..."
                      autocomplete="off"
                      data-qr-credential-picker-target="personName"
                      data-action="input->qr-credential-picker#update"
                    >
                  </div>

                  <div class="d-flex justify-content-end mt-3">
                    <button type="submit" class="btn btn-primary" data-qr-credential-picker-target="personSubmit" disabled>
                      <i class="bi bi-printer me-1"></i>Gerar por pessoa
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="modal-footer px-4 py-3">
              <span class="small text-secondary me-auto" data-qr-credential-picker-target="count">0 distritos selecionados</span>

              <%= link_to credenciais_admin_inscricoes_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-people me-1"></i>Gerar todos
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const initQrCredentialPicker = () => {
      const modal = document.getElementById("qrCredentialModal")
      if (!modal || modal.dataset.qrPickerReady === "true") return

      modal.dataset.qrPickerReady = "true"

      const districtCheckboxes = Array.from(modal.querySelectorAll('input[name="q[distrito_id_in][]"]'))
      const selectAll = modal.querySelector("#qr_credential_select_all_districts")
      const personName = modal.querySelector("#qr_credential_person_name")
      const districtSearch = modal.querySelector("#qr_credential_district_search")
      const districtOptions = Array.from(modal.querySelectorAll("[data-district-name]"))
      const emptyMessage = modal.querySelector('[data-qr-credential-picker-target="empty"]')
      const countLabels = Array.from(modal.querySelectorAll('[data-qr-credential-picker-target="count"]'))
      const districtSubmit = modal.querySelector('[data-qr-credential-picker-target="districtSubmit"]')
      const personSubmit = modal.querySelector('[data-qr-credential-picker-target="personSubmit"]')

      const normalize = (value) =>
        value.toString().normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim()

      const districtCountLabel = (selectedCount) => {
        if (selectedCount === 0) return "0 distritos selecionados"
        if (selectedCount === 1) return "1 distrito selecionado"
        return `${selectedCount} distritos selecionados`
      }

      const update = () => {
        const selectedCount = districtCheckboxes.filter((checkbox) => checkbox.checked).length
        const hasPersonName = personName.value.trim().length > 0

        selectAll.checked = selectedCount === districtCheckboxes.length
        countLabels.forEach((label) => {
          label.textContent = districtCountLabel(selectedCount)
        })

        districtSubmit.disabled = selectedCount === 0
        personSubmit.disabled = !hasPersonName
      }

      const filterDistricts = () => {
        const query = normalize(districtSearch.value)
        let visibleCount = 0

        districtOptions.forEach((option) => {
          const matches = normalize(option.dataset.districtName).includes(query)
          option.classList.toggle("d-none", !matches)
          if (matches) visibleCount += 1
        })

        emptyMessage.classList.toggle("d-none", visibleCount > 0)
      }

      selectAll.addEventListener("change", () => {
        districtCheckboxes.forEach((checkbox) => {
          checkbox.checked = selectAll.checked
        })
        update()
      })

      districtCheckboxes.forEach((checkbox) => checkbox.addEventListener("change", update))
      personName.addEventListener("input", update)
      districtSearch.addEventListener("input", filterDistricts)

      filterDistricts()
      update()
    }

    document.addEventListener("DOMContentLoaded", initQrCredentialPicker)
    document.addEventListener("turbo:load", initQrCredentialPicker)
    initQrCredentialPicker()
  })()
</script>

<%= render layout: "shared/admin_shell", locals: {
  title: "Leitor QR",
  subtitle: "Registre presença ou libere alimentação por refeição usando o QR Code da inscrição.",
  breadcrumbs: [
    { label: "Home", path: admin_root_path },
    { label: "Leitor QR" }
  ],
  actions: actions
} do %>
  <div class="row g-4 justify-content-center">
    <div class="col-12 col-xl-8">
      <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-4" data-controller="qr-reader">
          <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-4">
            <div>
              <h2 class="h5 fw-bold mb-1">Bipagem</h2>
              <p class="text-secondary mb-0">A leitura usa o token assinado da inscrição.</p>
            </div>
            <button type="button" class="btn btn-outline-primary" data-action="qr-reader#toggleCamera">
              <i class="bi bi-camera-video me-2"></i>Camera
            </button>
          </div>

          <video
            class="w-100 rounded-4 bg-dark d-none mb-3"
            style="aspect-ratio: 16 / 9; object-fit: cover;"
            playsinline
            muted
            data-qr-reader-target="video"
          ></video>

          <div class="alert alert-warning d-none" data-qr-reader-target="warning"></div>

          <%= form_with url: admin_leitor_qr_path, method: :post, data: { turbo: false, qr_reader_target: "form" } do |form| %>
            <div class="mb-3">
              <%= form.label :operacao, "Operacao", class: "form-label fw-semibold" %>
              <%= form.select :operacao,
                [["Registrar presenca", "presenca"], ["Liberar alimentacao", "alimentacao"]],
                { selected: @operacao },
                class: "form-select form-select-lg",
                data: { action: "change->qr-reader#syncOperation", qr_reader_target: "operation" } %>
            </div>

            <div class="mb-3" data-qr-reader-target="mealWrapper">
              <%= form.label :refeicao_id, "Refeicao", class: "form-label fw-semibold" %>
              <%= form.collection_select :refeicao_id,
                @refeicoes,
                :id,
                :nome_com_data,
                { prompt: "Selecione a refeicao", selected: @refeicao_id },
                class: "form-select form-select-lg" %>
            </div>

            <div class="mb-3">
              <%= form.label :token, "Token ou conteudo do QR", class: "form-label fw-semibold" %>
              <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-qr-code"></i></span>
                <%= form.text_field :token,
                  value: @token,
                  class: "form-control",
                  autocomplete: "off",
                  autofocus: true,
                  placeholder: "Cole ou leia o QR Code",
                  data: { qr_reader_target: "token" } %>
              </div>
            </div>

            <%= form.button class: "btn btn-primary btn-lg w-100" do %>
              <i class="bi bi-check2-circle me-2"></i>Validar credencial
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
