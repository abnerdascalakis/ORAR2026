<% content_for :title, "Refeições | Admin" %>
<% pode_alterar = !current_user&.read_only_admin? %>

<% actions = capture do %>
  <%= link_to admin_root_path, class: "btn btn-outline-light" do %>
    <i class="bi bi-arrow-left-circle me-2"></i>Voltar
  <% end %>

  <%= link_to admin_leitor_qr_path(operacao: "alimentacao"), class: "btn btn-outline-light" do %>
    <i class="bi bi-qr-code-scan me-2"></i>Leitor
  <% end %>

  <% if pode_alterar %>
    <%= link_to new_admin_refeicao_path, class: "btn btn-light shadow-sm" do %>
      <i class="bi bi-plus-circle me-2"></i>Nova refeicao
    <% end %>
  <% end %>
<% end %>

<%= render layout: "shared/admin_shell", locals: {
  title: "Refeições",
  subtitle: "Configure cada refeição que pode ser liberada uma unica vez por inscrição.",
  breadcrumbs: [
    { label: "Home", path: admin_root_path },
    { label: "Refeições" }
  ],
  actions: actions
} do %>
  <div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
      <div class="card admin-data-card border-0 rounded-4 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="admin-card-icon rounded-4 d-inline-flex align-items-center justify-content-center">
              <i class="bi bi-cup-hot fs-4"></i>
            </div>
            <div>
              <span class="text-secondary d-block">Refeicoes cadastradas</span>
              <strong class="h3 mb-0"><%= @refeicoes.count %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Refeicao</th>
              <th>Data</th>
              <th>Horario</th>
              <th>Consumos</th>
              <th class="text-end pe-4">Acoes</th>
            </tr>
          </thead>
          <tbody>
            <% @refeicoes.each do |refeicao| %>
              <tr>
                <td class="ps-4">
                  <strong class="d-block"><%= refeicao.nome %></strong>
                  <span class="text-secondary small"><%= refeicao.evento.descricao %></span>
                </td>
                <td><%= l(refeicao.data) %></td>
                <td>
                  <% if refeicao.horario_inicio.present? || refeicao.horario_fim.present? %>
                    <%= [refeicao.horario_inicio&.strftime("%H:%M"), refeicao.horario_fim&.strftime("%H:%M")].compact.join(" - ") %>
                  <% else %>
                    <span class="text-secondary">Nao informado</span>
                  <% end %>
                </td>
                <td><span class="badge rounded-pill text-bg-primary"><%= refeicao.consumo_alimentacoes.count %></span></td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-2">
                    <%= link_to admin_refeicao_path(refeicao), class: "btn btn-sm btn-primary" do %>
                      <i class="bi bi-eye me-1"></i>Ver
                    <% end %>
                    <% if pode_alterar %>
                      <%= link_to edit_admin_refeicao_path(refeicao), class: "btn btn-sm btn-outline-secondary" do %>
                        <i class="bi bi-pencil-square"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>

            <% if @refeicoes.empty? %>
              <tr>
                <td colspan="5" class="text-center text-secondary py-5">
                  <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                  Nenhuma refeicao cadastrada.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
