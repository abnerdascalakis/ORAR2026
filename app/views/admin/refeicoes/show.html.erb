<% content_for :title, "#{@refeicao.nome} | Admin" %>
<% pode_alterar = !current_user&.read_only_admin? %>

<% actions = capture do %>
  <%= link_to admin_refeicoes_path, class: "btn btn-outline-light" do %>
    <i class="bi bi-arrow-left-circle me-2"></i>Voltar
  <% end %>

  <%= link_to admin_leitor_qr_path(operacao: "alimentacao", refeicao_id: @refeicao.id), class: "btn btn-light shadow-sm" do %>
    <i class="bi bi-qr-code-scan me-2"></i>Liberar no leitor
  <% end %>

  <% if pode_alterar %>
    <%= link_to edit_admin_refeicao_path(@refeicao), class: "btn btn-outline-light" do %>
      <i class="bi bi-pencil-square me-2"></i>Editar
    <% end %>
  <% end %>
<% end %>

<%= render layout: "shared/admin_shell", locals: {
  title: @refeicao.nome,
  subtitle: @refeicao.nome_com_data,
  breadcrumbs: [
    { label: "Home", path: admin_root_path },
    { label: "Refeições", path: admin_refeicoes_path },
    { label: @refeicao.nome }
  ],
  actions: actions
} do %>
  <div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
      <div class="card admin-data-card border-0 rounded-4 shadow-sm h-100">
        <div class="card-body p-4">
          <span class="text-secondary d-block">Consumos registrados</span>
          <strong class="h3 mb-0"><%= @consumos.count %></strong>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 rounded-4 shadow-sm">
    <div class="card-header bg-white border-0 rounded-top-4 px-4 pt-4 pb-0">
      <h2 class="h5 fw-bold mb-1">Participantes liberados</h2>
      <p class="text-secondary mb-0">Cada participante aparece no maximo uma vez nesta refeicao.</p>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Pessoa</th>
              <th>Distrito</th>
              <th>Horario</th>
              <th>Operador</th>
            </tr>
          </thead>
          <tbody>
            <% @consumos.each do |consumo| %>
              <tr>
                <td class="ps-4">
                  <strong class="d-block"><%= consumo.inscricao.pessoa.nome %></strong>
                  <span class="text-secondary small"><%= consumo.inscricao.pessoa.telefone %></span>
                </td>
                <td><%= consumo.inscricao.distrito.nome %></td>
                <td><%= l(consumo.consumido_em, format: :short) %></td>
                <td><%= consumo.user.email %></td>
              </tr>
            <% end %>

            <% if @consumos.empty? %>
              <tr>
                <td colspan="4" class="text-center text-secondary py-5">
                  <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                  Nenhum consumo registrado.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
