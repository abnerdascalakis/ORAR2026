<% content_for :title, "Informações Gerais - ORAR 2026" %>
<%
  documentos_principais = [
    {
      titulo: "Programação ORAR 2026",
      etiqueta: "Programação",
      icone: "bi-calendar-event",
      arquivo: "ProgramaçãoORAR2026.pdf",
      descricao: "Confira a programação oficial do ORAR 2026 com horários e atividades para acompanhar o evento do começo ao fim.",
      botao: "Baixar programação"
    }
  ]

  regras_modalidades = [
    { titulo: "Futsal", arquivo: "FUTSAL-REGRAS.pdf", icone: "fa-solid fa-futbol" },
    { titulo: "Vôlei", arquivo: "VÔLEI-REGRAS.pdf", icone: "fa-solid fa-volleyball" },
    { titulo: "Natação", arquivo: "NATAÇÃO-REGRAS.pdf", icone: "fa-solid fa-person-swimming" },
    { titulo: "Corrida", arquivo: "CORRIDA-REGRAS.pdf", icone: "fa-solid fa-person-running" },
    { titulo: "Dodgeball", arquivo: "DODGEBALL-REGRAS.pdf", icone: "fa-solid fa-baseball" }
  ]

  pdf_path = ->(arquivo) { "/pdfs/#{ERB::Util.url_encode(arquivo)}" }
%>

<main class="orar-docs-page py-5">
  <div class="container orar-docs-container">
    <header class="text-center mb-5">
      <p class="orar-section-kicker mb-2">Documentação</p>
      <h1 class="display-5 fw-semibold text-marinho mb-3">Informações Gerais</h1>
      <p class="lead text-claro mb-0">Acesse a programação e as regras das modalidades do ORAR 2026.</p>
    </header>

    <div class="row g-4">
      <% documentos_principais.each do |documento| %>
        <div class="col-12 col-lg-8 mx-auto">
          <article class="card orar-doc-card h-100 border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5 d-flex flex-column">
              <span class="badge orar-doc-badge align-self-start mb-3">
                <i class="bi <%= documento[:icone] %> me-2" aria-hidden="true"></i><%= documento[:etiqueta] %>
              </span>
              <h2 class="h3 text-marinho mb-3"><%= documento[:titulo] %></h2>
              <p class="text-secondary mb-4"><%= documento[:descricao] %></p>
              <div class="orar-doc-preview rounded-4 border mb-4">
                <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
                <span>Clique para visualizar ou baixar o PDF</span>
              </div>
              <div class="d-flex gap-2 mt-auto">
                <a href="<%= pdf_path.call(documento[:arquivo]) %>" class="btn btn-outline-primary flex-fill" target="_blank" rel="noopener">
                  <i class="bi bi-eye me-2" aria-hidden="true"></i>Visualizar PDF
                </a>
                <a href="<%= pdf_path.call(documento[:arquivo]) %>" class="btn btn-marinho flex-fill" download>
                  <i class="bi bi-download me-2" aria-hidden="true"></i><%= documento[:botao] %>
                </a>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    </div>

    <section class="orar-rules-section mt-5">
      <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
        <div>
          <p class="orar-section-kicker mb-2">Modalidades</p>
          <h2 class="h3 text-marinho mb-0">Regras das modalidades</h2>
        </div>
      </div>

      <div class="row g-3">
        <% regras_modalidades.each do |regra| %>
          <div class="col-6 col-lg-4 col-xl">
            <article class="card orar-rule-card h-100 border-0 shadow-sm">
              <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="orar-rule-icon" aria-hidden="true">
                  <i class="<%= regra[:icone] %>"></i>
                </span>
                <div class="orar-rule-copy">
                  <h3 class="h6 text-marinho mb-1"><%= regra[:titulo] %></h3>
                  <a href="<%= pdf_path.call(regra[:arquivo]) %>" target="_blank" rel="noopener" class="stretched-link">
                    Ver regras
                  </a>
                </div>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</main>

<style>
  .text-marinho {
    color: #163a63 !important;
  }

  .text-claro {
    color: #5e86b5 !important;
  }

  .btn-marinho {
    background: linear-gradient(135deg, #2e5f95 0%, #5e86b5 100%);
    border: 0;
    color: #fff;
  }

  .btn-marinho:hover,
  .btn-marinho:focus {
    background: linear-gradient(135deg, #163a63 0%, #2e5f95 100%);
    color: #fff;
  }

  .orar-docs-page {
    background:
      radial-gradient(circle at top, rgba(217, 230, 245, 0.7), transparent 45%),
      linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
    min-height: calc(100vh - var(--orar-navbar-height));
  }

  .orar-docs-container {
    padding-top: calc(var(--orar-navbar-height) + 1rem);
  }

  .orar-doc-card {
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(28, 54, 84, 0.08);
  }

  .orar-doc-badge {
    background-color: #d9e6f5;
    color: #163a63;
    font-family: "Montserrat", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.6rem 0.9rem;
    text-transform: uppercase;
  }

  .orar-doc-preview {
    align-items: center;
    background: #f8f9fa;
    border-color: rgba(143, 175, 206, 0.55) !important;
    color: #6c757d;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
    min-height: 148px;
    padding: 1.5rem;
    text-align: center;
  }

  .orar-doc-preview i {
    color: #163a63;
    font-size: 2rem;
  }

  .orar-rules-section {
    border-top: 1px solid rgba(143, 175, 206, 0.3);
    padding-top: 2rem;
  }

  .orar-rule-card {
    border-radius: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .orar-rule-card:hover,
  .orar-rule-card:focus-within {
    box-shadow: 0 14px 32px rgba(28, 54, 84, 0.12) !important;
    transform: translateY(-2px);
  }

  .orar-rule-icon {
    align-items: center;
    background: #d9e6f5;
    border-radius: 8px;
    color: #163a63;
    display: inline-flex;
    flex: 0 0 48px;
    font-size: 1.25rem;
    height: 48px;
    justify-content: center;
    width: 48px;
  }

  .orar-rule-copy {
    min-width: 0;
  }

  .orar-rule-copy h3 {
    font-weight: 700;
  }

  .orar-rule-copy a {
    color: #2e5f95;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .orar-rule-copy a:hover,
  .orar-rule-copy a:focus {
    color: #163a63;
    text-decoration: underline;
  }

  @media (max-width: 575.98px) {
    .orar-docs-container {
      padding-top: calc(var(--orar-navbar-height) + 0.5rem);
    }

    .orar-doc-card .d-flex.gap-2 {
      flex-direction: column;
    }

    .orar-rule-card .card-body {
      align-items: flex-start !important;
      flex-direction: column;
      gap: 0.75rem !important;
      min-height: 132px;
      padding: 0.9rem !important;
    }

    .orar-rule-icon {
      flex-basis: 42px;
      font-size: 1.1rem;
      height: 42px;
      width: 42px;
    }

    .orar-rule-copy h3 {
      font-size: 0.95rem;
      line-height: 1.2;
    }

    .orar-rule-copy a {
      font-size: 0.84rem;
    }
  }
</style>
