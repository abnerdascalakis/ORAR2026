<% images = [
  {
    source: "abertura-1920.webp",
    srcset: [["abertura-768.webp", "768w"], ["abertura-1280.webp", "1280w"], ["abertura-1920.webp", "1920w"]]
  },
  {
    source: "investidura-1920.webp",
    srcset: [["investidura-768.webp", "768w"], ["investidura-1280.webp", "1280w"], ["investidura-1920.webp", "1920w"]]
  },
  {
    source: "humaita-1920.webp",
    srcset: [["humaita-768.webp", "768w"], ["humaita-1280.webp", "1280w"], ["humaita-1920.webp", "1920w"]]
  },
  {
    source: "setimus-1920.webp",
    srcset: [["setimus-768.webp", "768w"], ["setimus-1280.webp", "1280w"], ["setimus-1920.webp", "1920w"]]
  }
].select { |image| Rails.application.assets.load_path.find(image[:source]) } %>

<div id="orarCarousel" class="carousel slide orar-full-carousel" data-bs-ride="carousel" data-bs-interval="4500" data-bs-touch="true" data-bs-pause="false">
  <div class="carousel-indicators orar-carousel-indicators">
    <% images.each_with_index do |_image, index| %>
      <button
        type="button"
        data-bs-target="#orarCarousel"
        data-bs-slide-to="<%= index %>"
        class="<%= "active" if index.zero? %>"
        aria-current="<%= "true" if index.zero? %>"
        aria-label="Foto <%= index + 1 %>"
      ></button>
    <% end %>
  </div>

  <div class="carousel-inner">
    <% images.each_with_index do |image, index| %>
      <div class="carousel-item <%= "active" if index.zero? %>">
        <%= responsive_asset_picture(
          image[:source],
          alt: "ORAR 2026",
          sizes: "100vw",
          width: 1920,
          height: 1280,
          srcset: image[:srcset],
          img_class: "d-block w-100 orar-full-image",
          loading: (index.zero? ? "eager" : "lazy"),
          fetchpriority: (index.zero? ? "high" : "auto")
        ) %>
      </div>
    <% end %>
  </div>

  <div class="orar-carousel-caption text-center">
    <h1 class="mb-2">ORAR 2026</h1>
    <p class="mb-0">Olimpíada Regional Adventista de Rondônia</p>
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#orarCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Anterior</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#orarCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Próxima</span>
  </button>
</div>

<style>
  .orar-full-carousel {
    background: #0f0f0f;
    height: min(760px, calc(100svh - var(--orar-navbar-height, 88px)));
    min-height: 520px;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .orar-full-carousel::after {
    background:
      linear-gradient(90deg, rgba(5, 22, 34, 0.46), rgba(5, 22, 34, 0.1) 48%, rgba(5, 22, 34, 0.34)),
      linear-gradient(180deg, rgba(0, 0, 0, 0.08), transparent 38%, rgba(0, 0, 0, 0.2));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .orar-full-carousel .carousel-inner,
  .orar-full-carousel .carousel-item {
    height: 100%;
  }

  .orar-full-carousel .carousel-item {
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.9s ease;
  }

  .orar-full-carousel .carousel-item-next:not(.carousel-item-start),
  .orar-full-carousel .active.carousel-item-end {
    transform: translateX(100%);
  }

  .orar-full-carousel .carousel-item-prev:not(.carousel-item-end),
  .orar-full-carousel .active.carousel-item-start {
    transform: translateX(-100%);
  }

  .orar-full-carousel .carousel-item-next.carousel-item-start,
  .orar-full-carousel .carousel-item-prev.carousel-item-end {
    transform: translateX(0);
  }

  .orar-full-carousel .active.carousel-item-start,
  .orar-full-carousel .active.carousel-item-end {
    opacity: 0.35;
  }

  .orar-full-carousel .carousel-item-next,
  .orar-full-carousel .carousel-item-prev {
    opacity: 1;
  }

  .orar-full-carousel .orar-imagem {
    height: 100%;
  }

  .orar-full-image {
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
    width: 100%;
  }

  .orar-carousel-caption {
    color: #fff;
    inset: 50% auto auto 50%;
    padding: 0 1rem;
    position: absolute;
    text-shadow: 0 3px 16px rgba(0, 0, 0, 0.58);
    transform: translate(-50%, -50%);
    width: min(90%, 760px);
    z-index: 2;
  }

  .orar-carousel-caption h1 {
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .orar-carousel-caption p {
    font-size: clamp(0.95rem, 1.7vw, 1.15rem);
    font-weight: 500;
    opacity: 0.96;
  }

  .orar-full-carousel .carousel-control-prev,
  .orar-full-carousel .carousel-control-next {
    opacity: 1;
    width: 10%;
    z-index: 3;
  }

  .orar-full-carousel .carousel-control-prev-icon,
  .orar-full-carousel .carousel-control-next-icon {
    background-color: rgba(255, 255, 255, 0.14);
    background-size: 52%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    height: 3rem;
    transition: background-color 0.2s ease, transform 0.2s ease;
    width: 3rem;
  }

  .orar-full-carousel .carousel-control-prev:hover .carousel-control-prev-icon,
  .orar-full-carousel .carousel-control-next:hover .carousel-control-next-icon {
    background-color: rgba(15, 82, 100, 0.74);
    transform: scale(1.04);
  }

  .orar-carousel-indicators {
    bottom: 1.25rem;
    gap: 0.45rem;
    margin-bottom: 0;
    z-index: 3;
  }

  .orar-carousel-indicators [data-bs-target] {
    background-color: rgba(255, 255, 255, 0.66);
    border: 0;
    border-radius: 999px;
    height: 0.5rem;
    opacity: 1;
    transition: background-color 0.2s ease, width 0.2s ease;
    width: 0.5rem;
  }

  .orar-carousel-indicators .active {
    background-color: #8bd7e7;
    width: 1.8rem;
  }

  @media (max-width: 768px) {
    .orar-full-carousel {
      height: 56svh;
      min-height: 320px;
    }

    .orar-full-image {
      object-position: center;
    }

    .orar-carousel-caption {
      padding: 0 0.75rem;
      width: min(92%, 560px);
    }

    .orar-carousel-caption h1 {
      font-size: clamp(2rem, 9vw, 2.8rem);
      margin-bottom: 0.45rem !important;
    }

    .orar-carousel-caption p {
      font-size: clamp(0.95rem, 4vw, 1.1rem);
      line-height: 1.25;
    }

    .orar-full-carousel .carousel-control-prev,
    .orar-full-carousel .carousel-control-next {
      width: 14%;
    }

    .orar-full-carousel .carousel-control-prev-icon,
    .orar-full-carousel .carousel-control-next-icon {
      height: 2.45rem;
      width: 2.45rem;
    }
  }
</style>
